# Passwort für den Adminbereich (/admin). Pflichtfeld.
ADMIN_PASSWORD=bitte-aendern

# Zufälliger String zum Signieren des Admin-Cookies. Pflichtfeld.
# Erzeugen mit: openssl rand -hex 32
ADMIN_SECRET=bitte-aendern

# Wird von Vercel automatisch gesetzt, sobald ein Blob-Store verbunden ist.
# Lokal optional – ohne Token werden die Daten unter .data/exams.json abgelegt.
# BLOB_READ_WRITE_TOKEN=
